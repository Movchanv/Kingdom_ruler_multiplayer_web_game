APP_NAME="Medieval Realm (Staging)"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://staging.your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=medieval_realm
DB_USERNAME=medieval
DB_PASSWORD=__CHANGE_ME__

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.your-domain.com

CACHE_STORE=redis
CACHE_PREFIX=

QUEUE_CONNECTION=redis

BROADCAST_CONNECTION=reverb

FILESYSTEM_DISK=local

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=__CHANGE_ME__
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@staging.your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

REVERB_APP_ID=medieval-realm
REVERB_APP_KEY=__CHANGE_ME__
REVERB_APP_SECRET=__CHANGE_ME__
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

SANCTUM_STATEFUL_DOMAINS=staging.your-domain.com
FRONTEND_URL=https://staging.your-domain.com

VITE_APP_NAME="${APP_NAME}"
