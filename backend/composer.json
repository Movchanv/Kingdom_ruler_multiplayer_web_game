{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0",
        "laravel/horizon": "^5.47",
        "laravel/reverb": "^1.10",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^2.9",
        "predis/predis": "^3.5"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "3.10.0",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^10.5",
        "spatie/laravel-ignition": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --ansi"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-master": "11.x-dev"
        },
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "audit": {
            "ignore": {
                "PKSA-mdq4-51ck-6kdq": "CRLF dans la regle de validation email : le correctif amont n existe qu a partir de Laravel 12.60. Montee majeure 11 -> 12 planifiee (branche dediee + analyse d impact). Risque residuel nul ici : aucune adresse saisie par l utilisateur n est reinjectee dans un en-tete de courriel.",
                "PKSA-3r5d-mb8f-1qw9": "Meme avis que PKSA-mdq4-51ck-6kdq (doublon de referentiel).",
                "PKSA-m5cs-t1y6-qpcs": "Confusion de chemin sur les URL signees temporaires : corrige a partir de Laravel 12.61. Les seules URL signees du projet sont les liens de verification d adresse, dont le chemin est fixe. Leve avec la montee vers Laravel 12."
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
